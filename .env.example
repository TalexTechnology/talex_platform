# Copia este archivo a `.env` en la raíz del repo.
# `.env` está en .gitignore: no lo subas a GitHub ni lo pegues en el chat.

# Project Settings → General
SUPABASE_PROJECT_REF=inyjehqhrrneiufitwch
SUPABASE_URL=https://inyjehqhrrneiufitwch.supabase.co

# Project Settings → API Keys
# Publishable / anon: sí, para probar las RPC públicas.
SUPABASE_ANON_KEY=

# Secret / service_role: sí, solo para aplicar SQL y comprobar privilegios.
# Nunca va en Flutter, --dart-define, GitHub Actions ni el bundle web.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → API → JWT Secret. Solo en Cloud Functions.
# Nunca va en Flutter, --dart-define ni el bundle web.
SUPABASE_JWT_SECRET=

# Una de estas dos hace falta para `db push` / SQL remoto:
# 1) Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# 2) Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# API TaleX. La URI real va solo en `.env`, nunca en git.
MONGODB_URI=
MONGODB_DB=talex

