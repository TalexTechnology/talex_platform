SMTP_HOST=mail.talex.com.co
SMTP_PORT=465
SMTP_USER=info@talex.com.co
SMTP_PASS=
SMTP_FROM=info@talex.com.co
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY is a Secret Manager secret: firebase functions:secrets:set GEMINI_API_KEY
# askAssistant and affinity analysis both read that secret. It never ships in the client.

# Public Supabase values. getSupabasePublicConfig returns only these two.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Set with:
# firebase functions:secrets:set SUPABASE_JWT_SECRET
# firebase functions:secrets:set SUPABASE_SERVICE_ROLE_KEY
# Never put these in Flutter or the web bundle.
